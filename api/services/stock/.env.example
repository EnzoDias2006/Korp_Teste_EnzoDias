# HTTP server address (optional, defaults to :8081)
HTTP_ADDR=:8081

# PostgreSQL connection URL for stock_db (required)
DATABASE_URL=postgres://stock_user:stock_pass@localhost:5432/stock_db?sslmode=disable

# CORS allowed origins (optional, comma-separated list of explicit http/https origins)
# Example: CORS_ALLOWED_ORIGINS=http://localhost:4200,https://example.com
CORS_ALLOWED_ORIGINS=
