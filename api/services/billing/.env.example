# Billing Service Configuration
# Copy this file to .env and fill in the values

# HTTP server address (optional, defaults to :8082)
HTTP_ADDR=:8082

# PostgreSQL database connection URL (required)
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://billing_user:billing_pass@localhost:5432/billing_db?sslmode=disable

# Stock Service base URL (required)
# This is the URL of the Stock Service that the Billing Service will call
STOCK_SERVICE_URL=http://localhost:8081

# CORS allowed origins (optional, comma-separated list of explicit http/https origins)
# Example: CORS_ALLOWED_ORIGINS=http://localhost:4200,https://example.com
CORS_ALLOWED_ORIGINS=
