# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Explicit comma-separated browser origins allowed by both APIs
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Stock Service Configuration
STOCK_HTTP_ADDR=:8081
STOCK_DATABASE_URL=postgres://stock_user:stock_pass@localhost:5432/stock_db?sslmode=disable
STOCK_MIGRATION_DATABASE_URL=postgres://stock_user:stock_pass@postgres:5432/stock_db?sslmode=disable

# Billing Service Configuration
BILLING_HTTP_ADDR=:8082
BILLING_DATABASE_URL=postgres://billing_user:billing_pass@localhost:5432/billing_db?sslmode=disable
BILLING_MIGRATION_DATABASE_URL=postgres://billing_user:billing_pass@postgres:5432/billing_db?sslmode=disable
STOCK_SERVICE_URL=http://localhost:8081

# Database User Passwords (used in init scripts)
STOCK_DB_PASSWORD=stock_pass
BILLING_DB_PASSWORD=billing_pass
